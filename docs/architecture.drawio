<mxfile host="drawio" type="device"><diagram id="arch" name="How it works"><mxGraphModel dx="1800" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Recruiter Bot: how it works" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="It reads candidates and job openings, scores how well each person fits each job, and explains every match in plain words." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1300" height="26" as="geometry"/></mxCell><mxCell id="in_head" value="WHAT GOES IN" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="260" height="20" as="geometry"/></mxCell><mxCell id="candidates" value="&lt;b style=&quot;font-size:15px&quot;&gt;Candidates&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;People looking for work: their skills, years of experience, when they can start, and their personality traits&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="260" height="130" as="geometry"/></mxCell><mxCell id="jobs" value="&lt;b style=&quot;font-size:15px&quot;&gt;Job openings&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Roles to fill: the skills needed, the minimum experience, and the kind of team culture&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="260" height="130" as="geometry"/></mxCell><mxCell id="in_note" value="Loaded from files when the system starts, or added at any time through the API" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="260" height="40" as="geometry"/></mxCell><mxCell id="steps_head" value="HOW IT WORKS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#8c6bc8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="92" width="990" height="20" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Tidy the words&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;“Public Speaking” and “public-speaking” become the same word, so spelling never hides a match&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f0ff;strokeColor=#8c6bc8;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="225" height="220" as="geometry"/></mxCell><mxCell id="s1_n" value="1" style="ellipse;html=1;fillColor=#8c6bc8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="348" y="136" width="32" height="32" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Understand the meaning&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;A skills dictionary, based on the EU’s ESCO skills list, knows that “tenacious” means “persistent”, and that “persuasion” is close to “sales”&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f0ff;strokeColor=#8c6bc8;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="615" y="150" width="225" height="220" as="geometry"/></mxCell><mxCell id="s2_n" value="2" style="ellipse;html=1;fillColor=#8c6bc8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="603" y="136" width="32" height="32" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Score every pair&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;70% skills, 20% experience, 10% culture fit.&lt;br&gt;No skill in common, or too little experience: not a match&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f0ff;strokeColor=#8c6bc8;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="225" height="220" as="geometry"/></mxCell><mxCell id="s3_n" value="3" style="ellipse;html=1;fillColor=#8c6bc8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="858" y="136" width="32" height="32" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Save the answers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Every score and its reason is stored in the database, so results come back instantly&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f0ff;strokeColor=#8c6bc8;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1125" y="150" width="225" height="220" as="geometry"/></mxCell><mxCell id="s4_n" value="4" style="ellipse;html=1;fillColor=#8c6bc8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1113" y="136" width="32" height="32" as="geometry"/></mxCell><mxCell id="loop" value="&lt;b style=&quot;font-size:13px&quot;&gt;A word the dictionary doesn’t know?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Simple rules catch typos and word forms. An optional local AI can suggest a match, worth only a small, capped amount. A person approves it once, and the dictionary remembers it for everyone.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="360" y="430" width="480" height="120" as="geometry"/></mxCell><mxCell id="out_head" value="WHAT COMES OUT" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="92" width="300" height="20" as="geometry"/></mxCell><mxCell id="recruiter" value="&lt;b style=&quot;font-size:14px&quot;&gt;For a recruiter: who fits this job?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Candidates ranked best first, grouped as Strong or Possible. Plus great people who aren’t looking, flagged as worth a proactive offer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1400" y="118" width="300" height="150" as="geometry"/></mxCell><mxCell id="seeker" value="&lt;b style=&quot;font-size:14px&quot;&gt;For a candidate: which jobs suit me?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Jobs ranked best first, showing where they’re the top applicant.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1400" y="292" width="300" height="110" as="geometry"/></mxCell><mxCell id="example" value="&lt;b style=&quot;font-size:13px&quot;&gt;Every match explains itself&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;i&gt;Michael S. · score 71.7&lt;br&gt;2 of 3 skills (public speaking, sales) · missing negotiation · 11 years vs 3 required&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1400" y="430" width="300" height="120" as="geometry"/></mxCell><mxCell id="a_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#555555;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#555555;labelBackgroundColor=#ffffff;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="candidates" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_j" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#555555;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#555555;labelBackgroundColor=#ffffff;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobs" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#555555;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#555555;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#555555;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_r" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#82b366;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="recruiter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#82b366;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="seeker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#d79b00;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="loop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop_out" value="learns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=block;endFill=1;endSize=8;fontSize=12;fontColor=#d79b00;labelBackgroundColor=#ffffff;dashed=1;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="loop" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>